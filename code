@app.get("/api/home")
async def home():
    key = "home"
    cached = cache_get(key)
    if cached is not None:
        return cached

    async def get_page(page: int):
        return await tmdb_get(
            "/discover/movie",
            {
                "language": "en-US",
                "include_adult": "false",
                "include_video": "false",
                "sort_by": "popularity.desc",
                "vote_count.gte": 100,
                "page": page,
            },
        )

    page1, page2 = await asyncio.gather(
        get_page(1),
        get_page(2),
    )

    movies = []
    seen = set()

    for movie in (page1.get("results") or []) + (page2.get("results") or []):
        movie_id = movie.get("id")
        if not movie_id or movie_id in seen:
            continue
        if not movie.get("poster_path"):
            continue

        seen.add(movie_id)
        movies.append(clean_movie(movie))

        if len(movies) >= HOME_LIMIT:
            break

    payload = {"movies": movies, "count": len(movies)}
    cache_set(key, payload, CACHE_TTL_HOME)
    return payload

@app.get("/api/trending")
async def trending():
    key = "trending"
    cached = cache_get(key)
    if cached is not None:
        return cached

    data = await tmdb_get(
        "/trending/movie/week",
        {"language": "en-US"},
    )

    movies = [
        clean_movie(movie)
        for movie in (data.get("results") or [])
        if movie.get("poster_path")
    ][:TRENDING_LIMIT]

    payload = {"movies": movies, "count": len(movies)}
    cache_set(key, payload, CACHE_TTL_TRENDING)
    return payload

@app.get("/api/search")
async def search(
    q: str = Query(..., min_length=1, max_length=100)
):
    query = q.strip()
    key = f"search:{query.casefold()}"

    cached = cache_get(key)
    if cached is not None:
        return cached

    data = await tmdb_get(
        "/search/movie",
        {
            "query": query,
            "language": "en-US",
            "include_adult": "false",
            "page": 1,
        },
    )

    movies = [
        clean_movie(movie)
        for movie in (data.get("results") or [])
        if movie.get("poster_path")
    ][:SEARCH_LIMIT]

    payload = {
        "query": query,
        "movies": movies,
        "count": len(movies),
    }

    cache_set(key, payload, CACHE_TTL_SEARCH)
    return payload

