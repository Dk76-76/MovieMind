   ========================================================= */

function moveRecommendationsIntoModal() {

    const modalPanel =
        document.querySelector(
            "#movieModal .modal-panel"
        );

    const recommendationSection =
        $("#recommendations");

    if (
        !modalPanel ||
        !recommendationSection
    ) {
