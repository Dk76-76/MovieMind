@app.get("/api/movie/{tmdb_id}")
async def movie_details(tmdb_id: int):
    key = f"details:{tmdb_id}"
    cached = cache_get(key)
    if cached is not None:
        return cached

    details_task = tmdb_get(
        f"/movie/{tmdb_id}",
        {"language": "en-US"},
    )
    credits_task = tmdb_get(
        f"/movie/{tmdb_id}/credits",
        {"language": "en-US"},
    )
    videos_task = tmdb_get(
        f"/movie/{tmdb_id}/videos",
        {"language": "en-US"},
    )

    details, credits, videos = await asyncio.gather(
        details_task,
        credits_task,
        videos_task,
    )

    movie = clean_movie(details)

    cast = []
    for person in (credits.get("cast") or [])[:8]:
        cast.append({
            "name": person.get("name"),
            "character": person.get("character"),
            "profile": image_url(person.get("profile_path"), "w185"),
        })

    director = None
    for person in credits.get("crew") or []:
        if person.get("job") == "Director":
            director = person.get("name")
            break

    trailer_key = None
    for video in videos.get("results") or []:
        if (
            video.get("site") == "YouTube"
            and video.get("type") in {"Trailer", "Teaser"}
        ):
            trailer_key = video.get("key")
            if video.get("type") == "Trailer":
                break

    movie.update({
        "cast": cast,
        "director": director,
        "trailer_key": trailer_key,
        "homepage": details.get("homepage"),
        "budget": details.get("budget"),
        "revenue": details.get("revenue"),
    })

    cache_set(key, movie, CACHE_TTL_DETAILS)
    return movie

# ============================================================
# TF-IDF RECOMMENDATIONS
# ============================================================

@app.get("/api/recommendations")
async def recommendations(
    title: str = Query(..., min_length=1, max_length=200)
):
    if MODEL_ERROR is not None:
        raise HTTPException(
            status_code=500,
            detail=f"Recommendation model could not be loaded: {MODEL_ERROR}",
        )

    if df.empty or tfidf_matrix is None:
        raise HTTPException(
            status_code=500,
            detail="Recommendation model is empty.",
        )

    key = f"recommend:{normalize_title(title)}"
    cached = cache_get(key)
    if cached is not None:
        return cached

    movie_index = find_model_index(title)

    if movie_index is None:
        raise HTTPException(
            status_code=404,
            detail=f'"{title}" was not found in the recommendation model.',
        )

    try:
        scores = linear_kernel(
            tfidf_matrix[movie_index:movie_index + 1],
            tfidf_matrix,
        ).flatten()
    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail=f"Could not calculate recommendations: {exc}",
        ) from exc

    ranked_indices = scores.argsort()[::-1]

    local_titles = []
    selected_normalized = normalize_title(title)

    for idx in ranked_indices:
        if int(idx) == int(movie_index):
            continue

        if idx >= len(df):
            continue

        raw_title = str(df.iloc[int(idx)].get("title", "")).strip()
        if not raw_title:
            continue

        if normalize_title(raw_title) == selected_normalized:
            continue

        if raw_title not in local_titles:
            local_titles.append(raw_title)

        if len(local_titles) >= RECOMMEND_LIMIT:
            break

    # Resolve all recommendation posters/rating/info from TMDB concurrently.
    tmdb_results = await asyncio.gather(
        *(tmdb_search_one(movie_title) for movie_title in local_titles),
        return_exceptions=True,
    )

    movies = []
    seen_ids = set()

    for result in tmdb_results:
        if isinstance(result, Exception) or result is None:
            continue

        movie_id = result.get("id")
        if not movie_id or movie_id in seen_ids:
            continue

        if not result.get("poster_path"):
            continue

        seen_ids.add(movie_id)
        movies.append(clean_movie(result))

        if len(movies) >= RECOMMEND_LIMIT:
            break

    payload = {
        "based_on": title,
        "movies": movies,
        "count": len(movies),
    }

    cache_set(key, payload, CACHE_TTL_RECOMMEND)
    return payload


